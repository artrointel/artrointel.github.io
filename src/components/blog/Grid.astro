---
import Item from '~/components/blog/GridItem.astro';
import type { Post } from '~/types';
import type { Locale } from '~/i18n';

export interface Props {
  posts: Array<Post>;
  locale?: Locale;
}

const { posts, locale } = Astro.props;
---

<div class="-mb-6 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
  {posts.map((post) => <Item post={post} locale={locale} />)}
</div>
