---
import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';
import { getCanonical } from '~/utils/permalinks';
import { blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';
import type { MetaData, Post } from '~/types';
import type { Locale } from '~/i18n';

export interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const url = getCanonical(`/${locale}/${post.permalink}`);
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;
const alternatePaths = {
  en: post.translations?.en ? `/en/${post.translations.en}` : '/en/blog',
  ko: post.translations?.ko ? `/ko/${post.translations.ko}` : '/ko/blog',
};

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    canonical: String(url),
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      locale,
      ...(image
        ? { images: [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }] }
        : {}),
    },
  },
  post?.metadata ?? {}
) as MetaData;
---

<Layout metadata={metadata} locale={locale} alternatePaths={alternatePaths}>
  <SinglePost post={{ ...post, image }} url={url} locale={locale}>
    {post.Content ? <post.Content /> : <Fragment set:html={post.content || ''} />}
  </SinglePost>
  <ToBlogLink locale={locale} />
  <RelatedPosts post={post} locale={locale} />
</Layout>
