---
import { getLocalizedPath, locales, type Locale } from '~/i18n';

export interface Props {
  locale?: Locale;
  pathname?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
}

const { locale = 'en', pathname = Astro.url.pathname, alternatePaths = {} } = Astro.props;
---

<div
  class="relative z-20 mr-1 inline-flex h-9 items-center rounded-md border border-gray-200 bg-white p-0.5 text-xs font-semibold pointer-events-auto dark:border-slate-700 dark:bg-slate-900"
  role="group"
  aria-label={locale === 'ko' ? '언어 선택' : 'Select language'}
>
  {
    locales.map((item) => (
      <a
        href={alternatePaths[item] ?? getLocalizedPath(pathname, item)}
        data-astro-reload
        lang={item}
        hreflang={item}
        aria-current={item === locale ? 'page' : undefined}
        aria-label={item === 'ko' ? '한국어로 보기' : 'View in English'}
        class:list={[
          'flex h-7 min-w-8 cursor-pointer items-center justify-center rounded px-1.5 transition-colors pointer-events-auto',
          item === locale
            ? 'bg-gray-900 text-white dark:bg-white dark:text-slate-900'
            : 'text-muted hover:bg-gray-100 hover:text-gray-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white',
        ]}
      >
        {item.toUpperCase()}
      </a>
    ))
  }
</div>
