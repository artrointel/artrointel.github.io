---
import type { Locale } from '~/i18n';

interface LabItem {
  title: string;
  period: string;
  summary: string;
  tags: string[];
  links?: Array<{ label: string; href: string }>;
}

interface Props {
  items: LabItem[];
  locale?: Locale;
}

const { items, locale } = Astro.props;
const years = [...new Set(items.map((item) => item.period))].sort((a, b) => Number(b) - Number(a));
---

<div class="grid items-stretch gap-4 md:grid-cols-2 xl:grid-cols-3">
  {
    years.map((year, index) => {
      const yearItems = items.filter((item) => item.period === year);
      const isGrouped = yearItems.length >= 2;
      const Container = isGrouped ? 'details' : 'div';
      return (
        <Container
          class:list={[
            isGrouped
              ? 'lab-year col-span-full rounded-lg border-2 border-gray-100 p-3 dark:border-slate-800'
              : 'contents',
          ]}
          open={isGrouped && index === 0 ? true : undefined}
        >
          {isGrouped && (
            <summary class="w-fit cursor-pointer rounded-sm text-xs font-medium text-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary dark:text-slate-400">
              {year}
              <span class="ml-2 font-normal">
                {yearItems.length}
                {locale === 'ko' ? '개' : ' items'}
              </span>
            </summary>
          )}
          <div
            class:list={[
              isGrouped ? 'mt-3 grid items-stretch gap-4 md:auto-rows-fr md:grid-cols-2 xl:grid-cols-3' : 'contents',
            ]}
          >
            {yearItems.map((item) => (
              <article class="lab-card flex min-h-[280px] flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-700 dark:bg-slate-900">
                <div class="mb-4 flex items-start justify-between gap-4">
                  <h4 class="text-lg font-semibold leading-snug text-gray-900 dark:text-white">{item.title}</h4>
                  <span class="shrink-0 rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-200">
                    {item.period}
                  </span>
                </div>
                <p class="text-sm leading-6 text-muted dark:text-slate-300">{item.summary}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {item.tags.map((tag) => (
                    <span class="rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700 dark:bg-slate-800 dark:text-slate-300">
                      {tag}
                    </span>
                  ))}
                </div>
                {item.links && item.links.length > 0 && (
                  <div class="mt-auto pt-5">
                    <div class="flex flex-wrap gap-3 border-t border-gray-100 pt-4 dark:border-slate-800">
                      {item.links.map((link) => (
                        <a
                          class="rounded-sm text-sm font-semibold text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary dark:text-blue-300"
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </article>
            ))}
          </div>
        </Container>
      );
    })
  }
</div>
