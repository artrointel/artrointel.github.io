---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { getHeaderData, getFooterData } from '~/navigation';
import { defaultLocale, type Locale } from '~/i18n';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  locale?: Locale;
  alternatePaths?: Partial<Record<Locale, string>>;
}

const { metadata, locale, alternatePaths = {} } = Astro.props;
const displayLocale = locale ?? defaultLocale;
const headerData = getHeaderData(displayLocale);
const footerData = getFooterData(displayLocale);
---

<Layout metadata={metadata} locale={locale} alternatePaths={alternatePaths}>
  <slot name="announcement" />
  <slot name="header">
    <Header
      {...headerData}
      locale={displayLocale}
      homeHref={`/${displayLocale}`}
      alternatePaths={alternatePaths}
      isSticky
      showToggleTheme
    />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} homeHref={`/${displayLocale}`} />
  </slot>
</Layout>
