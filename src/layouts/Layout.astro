---
import '~/assets/styles/tailwind.css';
import 'katex/dist/katex.min.css';

import { I18N, SITE } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import LocaleRedirect from '~/components/common/LocaleRedirect.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';
import type { Locale } from '~/i18n';
import { getLocalizedPath } from '~/i18n';

export interface Props {
  metadata?: MetaDataType;
  locale?: Locale;
  alternatePaths?: Partial<Record<Locale, string>>;
}

const { metadata = {}, locale, alternatePaths = {} } = Astro.props;
const { textDirection } = I18N;
const language = locale ?? 'en';
const shouldDetectLocale = !locale;
const metadataWithLocale = {
  ...metadata,
  openGraph: { ...metadata.openGraph, locale: language },
};
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(en|ko)(?=\/|$)/, '') || '/';
const hasCoreAlternates = Boolean(locale) && ['/', '/about', '/resume', '/lab', '/blog'].includes(pathWithoutLocale);
const englishAlternate = alternatePaths.en ?? (hasCoreAlternates ? getLocalizedPath(Astro.url.pathname, 'en') : undefined);
const koreanAlternate = alternatePaths.ko ?? (hasCoreAlternates ? getLocalizedPath(Astro.url.pathname, 'ko') : undefined);
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    {shouldDetectLocale && <LocaleRedirect />}
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadataWithLocale} />
    {
      locale && englishAlternate && koreanAlternate && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(englishAlternate, SITE.site)} />
          <link rel="alternate" hreflang="ko" href={new URL(koreanAlternate, SITE.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(englishAlternate, SITE.site)} />
        </>
      )
    }
    <SiteVerification />
    <Analytics />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />
  </body>
</html>
