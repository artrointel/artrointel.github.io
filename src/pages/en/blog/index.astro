---
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import { fetchPosts, blogListRobots } from '~/utils/blog';

const posts = await fetchPosts();
const metadata = {
  title: 'Blog',
  description: 'Articles, tutorials, and engineering notes from Woohyun Kim in English and Korean.',
  robots: blogListRobots,
  openGraph: { type: 'blog', locale: 'en' },
};
---

<Layout metadata={metadata} locale="en">
  <section class="mx-auto max-w-4xl px-6 py-12 sm:px-6 sm:py-16 lg:py-20">
    <Headline subtitle="Insights, tutorials, and engineering notes on graphics, platforms, and AI.">The Blog</Headline>
    <BlogList posts={posts} locale="en" />
  </section>
</Layout>
