---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

type LabCategory = 'AI 활용 프로젝트' | '기술 실험' | '사이드 프로젝트' | '초기 프로젝트';

interface LabItem {
  title: string;
  period: string;
  category: LabCategory;
  summary: string;
  tags: string[];
  links?: Array<{ label: string; href: string }>;
}

const metadata = {
  title: '프로젝트 랩 - 김우현',
  description: '김우현의 AI 활용 프로젝트, 기술 실험, 사이드 프로젝트와 초기 프로젝트를 정리한 공간입니다.',
};

const labItems: LabItem[] = [
  {
    title: 'Rusher',
    period: '2026',
    category: 'AI 활용 프로젝트',
    summary: '업로드한 음악을 분석해 해당 트랙으로 플레이 가능한 리듬 게임을 생성하는 웹 애플리케이션입니다.',
    tags: ['리듬 게임', '음악 업로드', 'Web Audio', 'AI 지원 개발', 'Codex'],
    links: [{ label: '열기', href: 'https://artrointel.github.io/rusher' }],
  },
  {
    title: 'Dia2Dic',
    period: '2026',
    category: 'AI 활용 프로젝트',
    summary: '디아블로 II 아이템 정보를 빠르게 조회할 수 있도록 구축한 경량 검색형 데이터베이스입니다.',
    tags: ['게임 도구', '검색', 'AI 지원 개발', 'Codex'],
    links: [{ label: '열기', href: 'https://artrointel.github.io/dia2dic' }],
  },
  {
    title: 'Aion2Boss',
    period: '2025',
    category: 'AI 활용 프로젝트',
    summary: '아이온 2 필드 보스의 출현 일정을 추적하고 관리하기 위한 게임 보조 웹 애플리케이션입니다.',
    tags: ['게임 도구', '스케줄러', 'AI 지원 개발', 'Codex'],
    links: [{ label: '열기', href: 'https://artrointel.github.io/aion2boss' }],
  },
  {
    title: 'Minigame',
    period: '2025',
    category: 'AI 활용 프로젝트',
    summary: '무작위 추첨과 그룹 활동을 지원하는 웹 기반 미니게임 컬렉션입니다.',
    tags: ['웹 게임', '무작위 추첨', 'AI 지원 개발', 'Codex'],
    links: [{ label: '열기', href: 'https://metaintelligence.github.io/minigame' }],
  },
  {
    title: 'ShaderToy Contributions',
    period: '2023',
    category: '기술 실험',
    summary: '셰이더 렌더링과 화면 전환 효과를 검증하기 위해 공개한 GLSL 기반 그래픽스 실험입니다.',
    tags: ['GLSL', 'ShaderToy', 'Visual Effects'],
    links: [{ label: 'ShaderToy', href: 'https://www.shadertoy.com/results?query=artrointel' }],
  },
  {
    title: 'CanvasOverGLView / CanvasOverGLES',
    period: '2022',
    category: '기술 실험',
    summary: 'GLES 기반 View와 Surface 위에 Android Canvas 콘텐츠를 그리기 위한 그래픽스 라이브러리 실험입니다.',
    tags: ['Android', 'OpenGL ES', 'Canvas'],
    links: [{ label: 'GitHub', href: 'https://github.com/artrointel/CanvasOverGLES' }],
  },
  {
    title: 'Avengers Key',
    period: '2021',
    category: '사이드 프로젝트',
    summary: '애니메이션 그래픽 버튼과 로컬 PC 명령 제어 기능을 갖춘 Stream Deck 프로젝트입니다.',
    tags: ['Stream Deck', '데스크톱 도구', '애니메이션'],
    links: [{ label: 'GitHub', href: 'https://github.com/artrointel/streamdeck-avengers' }],
  },
  {
    title: 'EveryonesComplication',
    period: '2022',
    category: '사이드 프로젝트',
    summary: 'Android 워치 페이스에 비트코인 가격과 알림을 표시하는 Wear OS 컴플리케이션 앱 실험입니다.',
    tags: ['Wear OS', 'Complication', 'Android'],
    links: [{ label: 'GitHub', href: 'https://github.com/artrointel/EveryonesComplication' }],
  },
  {
    title: 'Sword Art Online: Babel of Dungeon',
    period: '2016',
    category: '초기 프로젝트',
    summary: '아티스트와 협업해 Unity3D로 개발한 로컬 인디 RPG 프로젝트입니다.',
    tags: ['Unity3D', '게임', '초기 프로젝트'],
    links: [{ label: 'YouTube', href: 'https://www.youtube.com/watch?v=FFwTGsyIyss&t=690s' }],
  },
];

const categories: Array<{ title: LabCategory; description: string }> = [
  { title: 'AI 활용 프로젝트', description: 'AI 지원 개발 워크플로로 구현한 실용 도구와 인터랙티브 애플리케이션입니다.' },
  { title: '기술 실험', description: '그래픽스 기술과 구현 아이디어의 타당성을 검증한 실험입니다.' },
  { title: '사이드 프로젝트', description: '주요 경력과 별도로 개발한 개인 도구 및 애플리케이션입니다.' },
  { title: '초기 프로젝트', description: '초기 개발 경력의 기술적 흐름을 보여주는 프로젝트입니다.' },
];
---

<Layout metadata={metadata} locale="ko">
  <div class="lab-content">
    <Hero
      tagline="LAB"
      classes={{
        container: 'py-10 md:py-14',
        copy: 'pb-0',
        subtitle: 'text-lg leading-8',
      }}
    >
      <Fragment slot="title">프로젝트 랩</Fragment>
      <Fragment slot="subtitle">주요 경력 외의 사이드 프로젝트, 기술 검증과 초기 개발 작업을 정리합니다.</Fragment>
    </Hero>

    <section class="pb-16 md:pb-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mb-8 grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:items-end">
          <div>
            <p class="text-sm font-bold uppercase text-primary dark:text-blue-200">구성</p>
            <h2 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">기타 프로젝트 및 기술 실험</h2>
          </div>
          <p class="text-base leading-7 text-muted dark:text-slate-300">
            핵심 경력과 기술 아티클에는 포함되지 않은 구현 결과와 실험 기록을 별도로 구성했습니다.
          </p>
        </div>

        <div class="space-y-12">
          {
            categories.map((category, categoryIndex) => {
              const items = labItems.filter((item) => item.category === category.title);
              const categoryId = `lab-ko-${categoryIndex}`;

              return (
                <section class="lab-category" aria-labelledby={categoryId}>
                  <div class="mb-5 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                      <h3 id={categoryId} class="text-2xl font-semibold text-gray-900 dark:text-white">{category.title}</h3>
                      <p class="mt-1 text-sm text-muted dark:text-slate-400">{category.description}</p>
                    </div>
                    <span class="text-sm text-muted dark:text-slate-400">{items.length}개</span>
                  </div>

                  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                    {items.map((item) => (
                      <article class="lab-card rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-700 dark:bg-slate-900">
                        <div class="mb-4 flex items-start justify-between gap-4">
                          <h4 class="text-lg font-semibold leading-snug text-gray-900 dark:text-white">{item.title}</h4>
                          <span class="shrink-0 rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-200">{item.period}</span>
                        </div>
                        <p class="text-sm leading-6 text-muted dark:text-slate-300 md:min-h-[5rem]">{item.summary}</p>
                        <div class="mt-5 flex flex-wrap gap-2">
                          {item.tags.map((tag) => <span class="rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700 dark:bg-slate-800 dark:text-slate-300">{tag}</span>)}
                        </div>
                        {item.links && item.links.length > 0 && (
                          <div class="mt-5 flex flex-wrap gap-3 border-t border-gray-100 pt-4 dark:border-slate-800">
                            {item.links.map((link) => <a class="text-sm font-semibold text-primary hover:underline dark:text-blue-300" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
                          </div>
                        )}
                      </article>
                    ))}
                  </div>
                </section>
              );
            })
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .lab-card { min-height: 280px; }
</style>
