---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import type { Locale } from '~/i18n';

export interface Props {
  locale?: Locale;
}

const { locale } = Astro.props;

type LabCategory = 'AI-Assisted Toys' | 'Experiments' | 'Side Projects' | 'Early Works';

interface LabItem {
  title: string;
  period: string;
  category: LabCategory;
  summary: string;
  tags: string[];
  links?: Array<{
    label: string;
    href: string;
  }>;
}

const metadata = {
  title: 'Lab - Woohyun Kim',
};

const labItems: LabItem[] = [
  {
    title: 'Rusher',
    period: '2026',
    category: 'AI-Assisted Toys',
    summary: 'A playful rhythm game that turns an uploaded music file into a playable rhythm-game session.',
    tags: ['Rhythm Game', 'Music Upload', 'Web Audio', 'AI-Assisted', 'Codex'],
    links: [{ label: 'Open', href: 'https://artrointel.github.io/rusher' }],
  },
  {
    title: 'Dia2Dic',
    period: '2026',
    category: 'AI-Assisted Toys',
    summary: 'A Diablo II encyclopedia page for looking up item information through a lightweight search interface.',
    tags: ['Game Utility', 'Search', 'AI-Assisted', 'Codex'],
    links: [{ label: 'Open', href: 'https://artrointel.github.io/dia2dic' }],
  },
  {
    title: 'Aion2Boss',
    period: '2025',
    category: 'AI-Assisted Toys',
    summary: 'A field boss spawn management page for Aion 2, made as a practical game-side companion tool.',
    tags: ['Game Utility', 'Scheduler', 'AI-Assisted', 'Codex'],
    links: [{ label: 'Open', href: 'https://artrointel.github.io/aion2boss' }],
  },
  {
    title: 'Minigame',
    period: '2025',
    category: 'AI-Assisted Toys',
    summary: 'A small web-based minigame collection made for casual random draws and lightweight group interactions.',
    tags: ['Web Game', 'Random Draw', 'AI-Assisted', 'Codex'],
    links: [{ label: 'Open', href: 'https://metaintelligence.github.io/minigame' }],
  },
  {
    title: 'ShaderToy Contributions',
    period: '2023',
    category: 'Experiments',
    summary: 'Small shader sketches and transition-effect experiments published separately from my main resume work.',
    tags: ['GLSL', 'ShaderToy', 'Visual Effects'],
    links: [{ label: 'ShaderToy', href: 'https://www.shadertoy.com/results?query=artrointel' }],
  },
  {
    title: 'CanvasOverGLView / CanvasOverGLES',
    period: '2022',
    category: 'Experiments',
    summary:
      'An Android graphics library experiment for drawing Android Canvas content over GLES-based View and Surface targets.',
    tags: ['Android', 'OpenGL ES', 'Canvas'],
    links: [{ label: 'GitHub', href: 'https://github.com/artrointel/CanvasOverGLES' }],
  },
  {
    title: 'Avengers Key',
    period: '2021',
    category: 'Side Projects',
    summary: 'A Stream Deck side project with animated graphic buttons and local PC command controls.',
    tags: ['Stream Deck', 'Desktop Tools', 'Animation'],
    links: [{ label: 'GitHub', href: 'https://github.com/artrointel/streamdeck-avengers' }],
  },
  {
    title: 'EveryonesComplication',
    period: '2022',
    category: 'Side Projects',
    summary: 'A Wear OS complication app experiment that displayed Bitcoin pricing and alarms on Android watch faces.',
    tags: ['Wear OS', 'Complication', 'Android'],
    links: [{ label: 'GitHub', href: 'https://github.com/artrointel/EveryonesComplication' }],
  },
  {
    title: 'Sword Art Online: Babel of Dungeon',
    period: '2016',
    category: 'Early Works',
    summary: 'A local indie RPG game experiment built with Unity3D in collaboration with an artist.',
    tags: ['Unity3D', 'Game', 'Early Work'],
    links: [{ label: 'YouTube', href: 'https://www.youtube.com/watch?v=FFwTGsyIyss&t=690s' }],
  },
];

const categories: Array<{
  title: LabCategory;
  description: string;
}> = [
  {
    title: 'AI-Assisted Toys',
    description: 'Small utilities and playful apps built primarily through AI-assisted development.',
  },
  {
    title: 'Experiments',
    description: 'Small technical probes, graphics sketches, and implementation ideas.',
  },
  {
    title: 'Side Projects',
    description: 'Personal tools and apps that sit outside the main resume narrative.',
  },
  {
    title: 'Early Works',
    description: 'Older projects kept as part of the development trail.',
  },
];
---

<Layout metadata={metadata} locale={locale}>
  <div class="lab-content">
    <Hero
      tagline="Lab"
      classes={{
        container: 'py-10 md:py-14',
        copy: 'pb-0',
        subtitle: 'text-lg leading-8',
      }}
    >
      <Fragment slot="title">Lab</Fragment>

      <Fragment slot="subtitle">
        Side projects, experiments, and archived works that sit outside my resume and blog.
      </Fragment>
    </Hero>

    <section class="pb-16 md:pb-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mb-8 grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:items-end">
          <div>
            <p class="text-sm font-bold uppercase tracking-wide text-primary dark:text-blue-200">Scope</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Non-resume workbench</h2>
          </div>
          <p class="text-base leading-7 text-muted dark:text-slate-300">
            Lab is intentionally separate from both Resume and Blog: it keeps smaller builds discoverable without
            treating them as career highlights or technical articles.
          </p>
        </div>

        <div class="space-y-12">
          {
            categories.map((category) => {
              const items = labItems.filter((item) => item.category === category.title);

              return (
                <section class="lab-category" aria-labelledby={`lab-${category.title.toLowerCase().replace(' ', '-')}`}>
                  <div class="mb-5 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                      <h3
                        id={`lab-${category.title.toLowerCase().replace(' ', '-')}`}
                        class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white"
                      >
                        {category.title}
                      </h3>
                      <p class="mt-1 text-sm text-muted dark:text-slate-400">{category.description}</p>
                    </div>
                    <span class="text-sm text-muted dark:text-slate-400">{items.length} items</span>
                  </div>

                  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                    {items.map((item) => (
                      <article class="lab-card rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-700 dark:bg-slate-900">
                        <div class="mb-4 flex items-start justify-between gap-4">
                          <h4 class="text-lg font-semibold leading-snug text-gray-900 dark:text-white">{item.title}</h4>
                          <span class="shrink-0 rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-200">
                            {item.period}
                          </span>
                        </div>

                        <p class="text-sm leading-6 text-muted dark:text-slate-300 md:min-h-[5rem]">{item.summary}</p>

                        <div class="mt-5 flex flex-wrap gap-2">
                          {item.tags.map((tag) => (
                            <span class="rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700 dark:bg-slate-800 dark:text-slate-300">
                              {tag}
                            </span>
                          ))}
                        </div>

                        {item.links && item.links.length > 0 && (
                          <div class="mt-5 flex flex-wrap gap-3 border-t border-gray-100 pt-4 dark:border-slate-800">
                            {item.links.map((link) => (
                              <a
                                class="text-sm font-semibold text-primary hover:underline dark:text-blue-300"
                                href={link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                {link.label}
                              </a>
                            ))}
                          </div>
                        )}
                      </article>
                    ))}
                  </div>
                </section>
              );
            })
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .lab-card {
    min-height: 280px;
  }
</style>
